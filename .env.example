# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.triaxisglobal.ae

# Set to "true" ONLY on the production deployment to allow search engine indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Admin API endpoint for form submissions, e.g. https://admin.example.com/api/public/enquiries
# Leave empty to run forms in preview/mock mode (nothing is sent or stored).
NEXT_PUBLIC_FORMS_ENDPOINT=

# --- Admin dashboard integration (admin-tri-axis repo) ---
# Base URL of the admin public API. When empty, the site uses the bundled local data in lib/data.
ADMIN_API_URL=
# Must match PUBLIC_API_KEY in the admin app (if set there).
ADMIN_API_KEY=
# How long (seconds) fetched content is cached before re-checking the API.
CONTENT_REVALIDATE_SECONDS=300
# Shared secret the admin uses to call /api/revalidate after content changes (WEBSITE_REVALIDATE_SECRET in the admin).
REVALIDATE_SECRET=

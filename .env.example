# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.triaxisglobal.ae

# Set to "true" ONLY on the production deployment to allow search engine indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Phase 2: admin API base URL for form submissions (contact, employer, candidate, job-application).
# Leave empty to run forms in preview/mock mode (nothing is sent or stored).
NEXT_PUBLIC_FORMS_ENDPOINT=

# ---------------------------------------------------------------------------
# TriAxis Admin — environment variables
# Copy to .env.local for local development; set the same keys in Vercel.
# ---------------------------------------------------------------------------

# MySQL / MariaDB
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Set to "true" if your database requires TLS.
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=5

# Session signing secret — at least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Public website
WEBSITE_URL=https://www.triaxisglobal.ae
NEXT_PUBLIC_WEBSITE_URL=https://www.triaxisglobal.ae
# Website origins allowed to POST form submissions (comma-separated).
CORS_ORIGINS=https://www.triaxisglobal.ae,https://dev.terminalx21.com,http://localhost:3000
# Called after every content change so the website refreshes immediately.
WEBSITE_REVALIDATE_URL=https://www.triaxisglobal.ae/api/revalidate
WEBSITE_REVALIDATE_SECRET=

# Optional: require this key (x-api-key header) on read endpoints. Set the same value as ADMIN_API_KEY on the website.
PUBLIC_API_KEY=

# This admin app's own URL (shown on the API & integration page).
NEXT_PUBLIC_ADMIN_URL=

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
